+    def test_on_gcode_response_records_suppression(self):
+        """A MR_NOTIFY_SKIP response arms suppression for the named state."""
+        self.data_sync_service._on_gcode_response("// MR_NOTIFY_SKIP: paused 30")
+
+        self.assertEqual(self.data_sync_service.suppressed_state, "paused")
+        self.assertIsNotNone(self.data_sync_service._suppress_expiry)
+
+    def test_suppression_request_is_not_stored_as_gcode_response(self):
+        """A MR_NOTIFY_SKIP response is consumed, not surfaced as a custom notification."""
+        self.data_sync_service._on_gcode_response("// MR_NOTIFY_SKIP: paused 30")
+
+        self.assertIsNone(self.data_sync_service.gcode_response)
+
+    def test_announcement_without_ttl_does_not_expire(self):
+        """Without a ttl the announcement waits indefinitely for its state."""
+        self.data_sync_service._on_gcode_response("// MR_NOTIFY_SKIP: paused")
+
+        self.assertEqual(self.data_sync_service.suppressed_state, "paused")
+        self.assertIsNone(self.data_sync_service._suppress_expiry)
+
+    def test_suppression_without_a_state_is_ignored(self):
+        """A malformed request leaves suppression disarmed."""
