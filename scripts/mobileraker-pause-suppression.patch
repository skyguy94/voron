+    def _resolve_suppressed_state(self, print_state: Optional[str]) -> Optional[str]:
+        '''
+        Resolve whether the announced state is still being suppressed.
+
+        An announcement holds until the state it names has come and gone, or
+        until the printer clears it. A ttl is optional and only bounds how long
+        it waits for that state to arrive.
+
+        Returns:
+            Optional[str]: The suppressed state, or None.
+        '''
+        if self.suppressed_state is None:
+            return None
+        if print_state == self.suppressed_state:
+            self._suppress_entered = True
+            return self.suppressed_state
+        if self._suppress_entered:
+            self._clear_notify_skip()
+            return None
+        if self._suppress_expiry is not None and time.monotonic() >= self._suppress_expiry:
+            self._clear_notify_skip()
+            return None
+        return self.suppressed_state
+
