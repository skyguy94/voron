+
+        snap = self.data_sync_service.take_snapshot()
+
+        self.assertEqual(snap.suppressed_state, "paused")
+        self.assertTrue(snap.is_suppressed_state or snap.print_state != "paused")
+
+    def test_expired_suppression_is_absent_from_snapshot(self):
+        """A suppression that has run out of ttl is not applied."""
+        self.data_sync_service.klippy_ready = True
