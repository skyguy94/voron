+    def _parse_notify_skip_request(self, payload: str) -> None:
+        '''
+        Handle a MR_NOTIFY_SKIP request from the printer.
+
+        The ttl covers the gap between this message and the state change it
+        announces, not how long that state lasts, so a short value is correct
+        even for a long pause.
+
+        Returns:
+            None
+        '''
+        max_ttl = 900.0
+
+        parts = payload.split()
+        if not parts:
+            self._logger.warning("Received a notification-skip request without a state. Ignoring...")
+            return
+
+        if parts[0].strip().lower() == 'clear':
+            self._logger.info("Printer cleared its '%s' announcement.", self.suppressed_state)
+            self._clear_notify_skip()
+            return
+
+        state = parts[0].strip().lower()
+        expiry = None
+        if len(parts) > 1:
+            try:
+                expiry = time.monotonic() + max(0.0, min(float(parts[1]), max_ttl))
+            except ValueError:
+                self._logger.warning("Could not parse ttl %r, announcement will not expire", parts[1])
+        self.suppressed_state = state
+        self._suppress_expiry = expiry
+        self._suppress_entered = False
+        self._logger.info("Printer announced a '%s' state%s.", state,
+                          " within %.0fs" % (expiry - time.monotonic()) if expiry else "")
+
+    def _clear_notify_skip(self) -> None:
+        '''
+        Drop any announcement the printer has made.
+
+        Returns:
+            None
+        '''
+        self.suppressed_state = None
+        self._suppress_expiry = None
+        self._suppress_entered = False
+
