         self.assertIsNone(resumed.suppressed_state)
         self.assertIsNone(self.data_sync_service.suppressed_state)
 
+    def test_timelapse_frame_arms_the_same_announcement(self):
+        """The timelapse plugin now routes through the general mechanism."""
+        self.data_sync_service._parse_objects(
+            {"gcode_macro TIMELAPSE_TAKE_FRAME": {"is_paused": True}})
+
+        self.assertEqual(self.data_sync_service.suppressed_state, "paused")
+
+    def test_timelapse_announcement_clears_when_the_pause_ends(self):
+        """No reset bookkeeping is needed, the state ending is enough."""
+        self.data_sync_service.klippy_ready = True
+        self.data_sync_service._parse_objects(
+            {"gcode_macro TIMELAPSE_TAKE_FRAME": {"is_paused": True}})
+        self.data_sync_service.print_stats = self.data_sync_service.print_stats.updateWith(
+            {"state": "paused"})
+        self.data_sync_service.take_snapshot()
+
+        self.data_sync_service.print_stats = self.data_sync_service.print_stats.updateWith(
+            {"state": "printing"})
+        resumed = self.data_sync_service.take_snapshot()
+
+        self.assertIsNone(resumed.suppressed_state)
+
     def test_clear_disarms_the_announcement(self):
         """The printer can withdraw an announcement it no longer needs."""
         self.data_sync_service._on_gcode_response("// MR_NOTIFY_SKIP: error")
